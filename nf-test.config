manifest {
	author = "Richard Ellis"
	homePage = "https://github.com/aphascience/Strepsuis_seq"
    description = "This is APHA's pipeline for processing of Streptococcus suis WGS data. This has been built to run using nextflow"
    mainScript = "main.nf"
}

config {

    testsDir = "tests"
    workDir = ".nf-test"
    configFile = "tests/nextflow.config"
    profile = "docker"
}

/* remove contents of work directory after pipeline completes sucessfully */
cleanup = true
