/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

profiles {
    docker {
        process.container = "${secrets.ECR_ACCOUNT}.dkr.ecr.eu-west-1.amazonaws.com/gitrun-csu-1016:${secrets.BRANCH}"
        docker.enabled = true
    }
}

/* do not use default file clean up when testing */
cleanup = false
params.rmInter = false